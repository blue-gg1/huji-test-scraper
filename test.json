[{'id': 8532, 'name': {'he': 'מתמטיקה דיסקרטית', 'en': 'DISCRETE MATHEMATICS'}, 'code': '80181', 'departmentId': 184, 'departmentName': {'he': 'מתמטיקה', 'en': 'Mathematics'}, 'facultyName': {'he': 'פקולטה למתמטיקה ולמדעי הטבע', 'en': 'Faculty of Sciences'}, 'academicPoints': 5, 'teacherCode': None, 'remark': {'he': '<p style="margin-left: 0; margin-right: 0">ציונים בקורס זה יתפרסמו לאחר 10 ימי עבודה, לפי החלטת וועדת הוראה. שיעור ב\' מיועד לתלמידי החוג להנדסה (583). תרגיל ט\' מומלץ לתלמידי תיכון ליד"ה. תרגיל י\' מיועד לתלמידים דוברי ערבית. מומלץ ללמוד את הקורס בסמסטר א\'. תלמידי ביולוגיה חישובית לומדים את הקורס בסמסטר א\'. קורס זה הוא מודולרי ולכן יש לבדוק את הנחיות הקורס באתר הקורס, בסמסטר הרלוונטי לתלמיד/ה.</p>', 'en': '<p style="margin-left: 0; margin-right: 0">Students of computer science-cognitive science and students of mathematics-cognitive science are advised to enroll in Class 2. Students of Leyada High School are advised to enroll in Tutorial 9. It is recommended to take the course in the first semester.</p>'}, 'coursePeriod': 3, 'coursePeriodName': {'he': 'סמסטר א או ב', 'en': 'Semester A or B'}, 'coursePeriodOrder': 2, 'courseStructureType': 'שעור ותרגיל מפוצל', 'courseStructureID': 9, 'startDate': None, 'endDate': None, 'lastYearGradeAvg': 74.06410256410257, 'sugToar': '001', 'totalHours': 70, 'isLearning': 1, 'statusCourseCode': 1, 'year': 2026, 'groups': [], 'studySessionTypeName': None}]